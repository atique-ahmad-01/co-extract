# openai or anthropic; if unset, whichever key is present is used
# LLM_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Extraction samples per document
LLM_SAMPLES=3
# Fields below this confidence set needs_review
REVIEW_THRESHOLD=0.6
